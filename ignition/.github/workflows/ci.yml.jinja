name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@7b6663bd7c4c5e94e73b853f4f47ee718edc96d4 # v7.0.27
    with:
      skip-hooks: 'pylint'

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@7b6663bd7c4c5e94e73b853f4f47ee718edc96d4 # v7.0.27
