name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@1dd98a3d17610e40b8622a7304e81d0227bb7509 # v7.0.36
    with:
      skip-hooks: 'pylint'

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@1dd98a3d17610e40b8622a7304e81d0227bb7509 # v7.0.36
