name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@5c1aa5d7e94ff5ceeafdb518feee45fb0b74155e # v7.0.26
    with:
      skip-hooks: 'pylint'

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@5c1aa5d7e94ff5ceeafdb518feee45fb0b74155e # v7.0.26
