name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@f510d3ed80fd75af838ca94a07ca2cd24e5221f3 # v7.0.22
    with:
      skip-hooks: 'pylint'

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@f510d3ed80fd75af838ca94a07ca2cd24e5221f3 # v7.0.22
