name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@fbc642c450cdcec3bbc241de8be94e944265d4f1 # v7.1.4
    with:
      skip-hooks: 'pylint'
      python-version: |
        3.12
        3.15

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@fbc642c450cdcec3bbc241de8be94e944265d4f1 # v7.1.4
    with:
      path: 'src'

  tox-package:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@fbc642c450cdcec3bbc241de8be94e944265d4f1 # v7.1.4

  tox-stubs:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox.yml@fbc642c450cdcec3bbc241de8be94e944265d4f1 # v7.1.4
    with:
      python-versions: |
        3.10
        3.11
        3.12
      working-directory: stubs
