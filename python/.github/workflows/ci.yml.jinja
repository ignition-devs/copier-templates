name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@0d8d2f45676648a5770bb2f9bb5678bf789db46c # v7.1.3
    with:
      skip-hooks: 'pylint'
      python-version: |
        3.12
        3.15

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@0d8d2f45676648a5770bb2f9bb5678bf789db46c # v7.1.3
    with:
      path: 'src'

  tox-package:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@0d8d2f45676648a5770bb2f9bb5678bf789db46c # v7.1.3

  tox-stubs:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox.yml@0d8d2f45676648a5770bb2f9bb5678bf789db46c # v7.1.3
    with:
      python-versions: |
        3.10
        3.11
      working-directory: stubs
