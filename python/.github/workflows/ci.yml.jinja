name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@ac7772bd171c548f66cbd19be77872dfd6e326ce # v7.0.24
    with:
      skip-hooks: 'pylint'

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@ac7772bd171c548f66cbd19be77872dfd6e326ce # v7.0.24

  tox-package:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@ac7772bd171c548f66cbd19be77872dfd6e326ce # v7.0.24

  tox-stubs:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox.yml@ac7772bd171c548f66cbd19be77872dfd6e326ce # v7.0.24
    with:
      python-versions: |
        3.9
        3.10
        3.11
        3.12
      working-directory: stubs
