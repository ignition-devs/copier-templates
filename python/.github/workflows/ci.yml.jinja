name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@c162b4f86c1f53e67214af8cf85fca77d41492d5 # v7.1.7
    with:
      skip-hooks: 'pylint'
      python-version: |
        3.12
        3.15

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@c162b4f86c1f53e67214af8cf85fca77d41492d5 # v7.1.7
    with:
      path: 'src'

  tox-package:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@c162b4f86c1f53e67214af8cf85fca77d41492d5 # v7.1.7

  tox-stubs:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox.yml@c162b4f86c1f53e67214af8cf85fca77d41492d5 # v7.1.7
    with:
      python-versions: |
        3.10
        3.11
        3.12
      working-directory: stubs
