name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@a58877dc74fd563f9f4ba98d72c695df8fb19f8a # v7.1.5
    with:
      skip-hooks: 'pylint'
      python-version: |
        3.12
        3.15

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@a58877dc74fd563f9f4ba98d72c695df8fb19f8a # v7.1.5
    with:
      path: 'src'

  tox-package:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@a58877dc74fd563f9f4ba98d72c695df8fb19f8a # v7.1.5

  tox-stubs:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox.yml@a58877dc74fd563f9f4ba98d72c695df8fb19f8a # v7.1.5
    with:
      python-versions: |
        3.10
        3.11
        3.12
      working-directory: stubs
