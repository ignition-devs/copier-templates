name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@14c26346d404da7cc780a7952deae705fff56e10 # v7.0.31
    with:
      skip-hooks: 'pylint'

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@14c26346d404da7cc780a7952deae705fff56e10 # v7.0.31

  tox-package:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@14c26346d404da7cc780a7952deae705fff56e10 # v7.0.31

  tox-stubs:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox.yml@14c26346d404da7cc780a7952deae705fff56e10 # v7.0.31
    with:
      python-versions: |
        3.9
        3.10
        3.11
        3.12
      working-directory: stubs
