name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@0998a0f89d8aa907d16b22bfb1874a0e42973f8b # v7.0.29
    with:
      skip-hooks: 'pylint'

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@0998a0f89d8aa907d16b22bfb1874a0e42973f8b # v7.0.29

  tox-package:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@0998a0f89d8aa907d16b22bfb1874a0e42973f8b # v7.0.29

  tox-stubs:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox.yml@0998a0f89d8aa907d16b22bfb1874a0e42973f8b # v7.0.29
    with:
      python-versions: |
        3.9
        3.10
        3.11
        3.12
      working-directory: stubs
