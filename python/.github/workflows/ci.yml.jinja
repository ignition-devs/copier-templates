name: ci

on:
  workflow_dispatch:
  pull_request:
  push:
    branches:
      - {{ main_branch }}

jobs:
  pre-commit:
    uses: coatl-dev/workflows/.github/workflows/pre-commit.yml@fbb4c65688da8a630c087fcc71fed9d93dd9e162 # v7.0.33
    with:
      skip-hooks: 'pylint'

  pylint:
    needs: pre-commit
    uses: coatl-dev/workflows/.github/workflows/pylint.yml@fbb4c65688da8a630c087fcc71fed9d93dd9e162 # v7.0.33
    with:
      path: 'src'

  tox-package:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@fbb4c65688da8a630c087fcc71fed9d93dd9e162 # v7.0.33

  tox-stubs:
    if: ${% raw %}{{ github.event_name == 'pull_request' }}{% endraw %}
    uses: coatl-dev/workflows/.github/workflows/tox.yml@fbb4c65688da8a630c087fcc71fed9d93dd9e162 # v7.0.33
    with:
      python-versions: |
        3.9
        3.10
        3.11
        3.12
      working-directory: stubs
