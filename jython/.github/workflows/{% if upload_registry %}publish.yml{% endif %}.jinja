name: publish

on:
  release:
    types:
      - published

jobs:
  tox-package:
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@c162b4f86c1f53e67214af8cf85fca77d41492d5 # v7.1.7

  tox-stubs:
    uses: coatl-dev/workflows/.github/workflows/tox.yml@c162b4f86c1f53e67214af8cf85fca77d41492d5 # v7.1.7
    with:
      python-versions: |
        3.9
        3.10
        3.11
        3.12
      working-directory: stubs

  pypi-publish-package:
    needs: [tox-package]
    uses: coatl-dev/workflows/.github/workflows/pypi-upload.yml@c162b4f86c1f53e67214af8cf85fca77d41492d5 # v7.1.7
    with:
      python-version: '2.7'
      url: '{{ registry_url }}'
      username: '{{ registry_username }}'
    secrets:
      password: ${% raw %}{{ secrets.SECRET_TOKEN_OR_PASSWORD }}{% endraw %}

  pypi-publish-stubs:
    needs: [tox-stubs]
    uses: coatl-dev/workflows/.github/workflows/pypi-upload.yml@c162b4f86c1f53e67214af8cf85fca77d41492d5 # v7.1.7
    with:
      python-version: '3.12'
      url: '{{ registry_url }}'
      username: '{{ registry_username }}'
      working-directory: 'stubs'
    secrets:
      password: ${% raw %}{{ secrets.SECRET_TOKEN_OR_PASSWORD }}{% endraw %}
