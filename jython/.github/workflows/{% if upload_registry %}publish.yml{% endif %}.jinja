name: publish

on:
  release:
    types:
      - published

jobs:
  tox-package:
    uses: coatl-dev/workflows/.github/workflows/tox-docker.yml@65d1a1eda04de5bb54bd5057b3ebe4b7c8fa4b45 # v7.1.6

  tox-stubs:
    uses: coatl-dev/workflows/.github/workflows/tox.yml@65d1a1eda04de5bb54bd5057b3ebe4b7c8fa4b45 # v7.1.6
    with:
      python-versions: |
        3.9
        3.10
        3.11
        3.12
      working-directory: stubs

  pypi-publish-package:
    needs: [tox-package]
    uses: coatl-dev/workflows/.github/workflows/pypi-upload.yml@65d1a1eda04de5bb54bd5057b3ebe4b7c8fa4b45 # v7.1.6
    with:
      python-version: '2.7'
      url: '{{ registry_url }}'
      username: '{{ registry_username }}'
    secrets:
      password: ${% raw %}{{ secrets.SECRET_TOKEN_OR_PASSWORD }}{% endraw %}

  pypi-publish-stubs:
    needs: [tox-stubs]
    uses: coatl-dev/workflows/.github/workflows/pypi-upload.yml@65d1a1eda04de5bb54bd5057b3ebe4b7c8fa4b45 # v7.1.6
    with:
      python-version: '3.12'
      url: '{{ registry_url }}'
      username: '{{ registry_username }}'
      working-directory: 'stubs'
    secrets:
      password: ${% raw %}{{ secrets.SECRET_TOKEN_OR_PASSWORD }}{% endraw %}
